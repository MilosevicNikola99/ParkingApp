# Local development defaults only. Replace credentials and secrets before deployment.
APP_NAME=Parking Management API
ENVIRONMENT=local
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=parking_app
DATABASE_USER=parking_app
DATABASE_PASSWORD=parking_app
DATABASE_PASSWORD_FILE=
POSTGRES_PASSWORD_FILE=
DATABASE_URL=postgresql+psycopg://parking_app:parking_app@localhost:5432/parking_app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# Production: load a high-entropy JWT secret from a secret manager.
JWT_SECRET_KEY=change-this-in-real-environments
JWT_SECRET_FILE=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SAME_TEAM_PRIORITY_WINDOW_HOURS=2
RECENT_WIN_FAIRNESS_WINDOW_DAYS=30
RECENT_WIN_SOFT_LIMIT=2
ASSIGNMENT_SCHEDULER_ENABLED=false
ASSIGNMENT_SCHEDULER_INTERVAL_SECONDS=60
ASSIGNMENT_SCHEDULER_BATCH_LIMIT=100
ASSIGNMENT_SCHEDULER_LOCK_KEY=740730001
ASSIGNMENT_SCHEDULER_RUN_IMMEDIATELY=true
METRICS_ENABLED=true
METRICS_PATH=/metrics
SCHEDULER_METRICS_PORT=9101
READINESS_DATABASE_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
LOG_JSON=true
# Production compose uses PRODUCTION_CORS_ALLOWED_ORIGINS from the root environment.
PRODUCTION_CORS_ALLOWED_ORIGINS=["https://parking.example.com"]
# Exact browser origins only. Wildcards are rejected; credentials require exact origins.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=false

# Local admin seed is disabled by default. Never enable it in production.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_UPDATE_PASSWORD=false
